ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Server
API_V1_PREFIX=/api/v1
PROJECT_NAME=Edure
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=satzone
POSTGRES_PASSWORD=satzone
POSTGRES_DB=satzone
SQL_ECHO=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Auth — REPLACE IN PRODUCTION
JWT_SECRET_KEY=change-me-please-generate-a-strong-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_HOURS=48

# Rate limiting (per IP, sliding window)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Mail (dev mode logs to console; set MAIL_BACKEND=smtp for real delivery)
MAIL_BACKEND=console
MAIL_FROM=no-reply@edure.local
MAIL_FROM_NAME=Edure
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Frontend URL — used for verification & reset links
FRONTEND_URL=http://localhost:3000

# Media uploads (instructor videos, thumbnails, resources)
MEDIA_ROOT=media
MEDIA_URL=/media