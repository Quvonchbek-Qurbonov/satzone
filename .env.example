ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Server
API_V1_PREFIX=/api/v1
PROJECT_NAME=Edure
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=satzone
POSTGRES_PASSWORD=satzone
POSTGRES_DB=satzone
SQL_ECHO=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Auth — REPLACE IN PRODUCTION
JWT_SECRET_KEY=change-me-please-generate-a-strong-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_HOURS=48
# Phone verification — codes are delivered via SMS (see SMS_BACKEND below).
# PHONE_CODE_LENGTH must be in [4, 10].
PHONE_VERIFY_EXPIRE_MINUTES=15
PHONE_VERIFY_MAX_ATTEMPTS=5
PHONE_CODE_LENGTH=6

# Rate limiting (per IP, sliding window)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Mail (console = log only; smtp = legacy SMTP; brevo = Brevo transactional API)
MAIL_BACKEND=console
MAIL_FROM=no-reply@edure.local
MAIL_FROM_NAME=Edure
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
BREVO_API_KEY=

# Phone verification — master delivery switch.
#   false (default) → OTP is EMAILED to the user's account email. Great for
#                     local dev: no provider key, no real phone needed, no
#                     country-format pain. Just check the inbox / console.
#   true            → OTP goes through SMS_BACKEND below (real SMS).
# Flip to true in staging/prod.
USE_SMS_PROVIDER=false

# SMS provider (only consulted when USE_SMS_PROVIDER=true).
#   console = log the body to stdout (still skips the real provider);
#   brevo   = Brevo transactional SMS API;
#   infobip = Infobip /sms/2/text/advanced.
# BREVO_API_KEY is shared with the email backend. BREVO_SMS_SENDER /
# INFOBIP_SMS_SENDER must be approved by the provider — alphanumeric (max 11
# chars) in most countries, numeric in those that block alpha senders.
# INFOBIP_BASE_URL is the personalized host shown in your Infobip portal
# (e.g. l2mgwd.api.infobip.com); scheme is optional.
SMS_BACKEND=console
BREVO_SMS_SENDER=Edure
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SMS_SENDER=Edure

# Frontend URL — used for password reset links (and post-verify redirect, when wired)
FRONTEND_URL=http://localhost:3000
# Public base URL of THIS api — used to build clickable links in outbound emails
API_BASE_URL=http://localhost:8000

# Google OAuth — register the redirect URI below in Google Cloud Console → OAuth client → Authorized redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Media uploads (instructor videos, thumbnails, resources)
STORAGE_BACKEND=local      # local | s3
MEDIA_ROOT=media           # local backend
MEDIA_URL=/media           # local backend

# AWS S3 (only required when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=    # optional — CloudFront / custom domain in front of the bucket

# --- Video streaming protection ---
# Mirror S3 uploads to MEDIA_ROOT so the streaming proxy can serve from local
# disk first and fall back to S3.
STORAGE_DUAL_WRITE=true
# How long signed playback tokens remain valid (seconds). Must exceed the
# longest expected video duration since the manifest bakes the token into
# every segment URL; IP binding makes longer windows safe.
STREAM_TOKEN_TTL_SECONDS=1800
# Key-encryption key wrapping per-lesson AES-128 HLS keys at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_KEK=
# ffmpeg path — override if not on PATH (e.g. /usr/bin/ffmpeg).
FFMPEG_BIN=ffmpeg
HLS_SEGMENT_SECONDS=6
HLS_AUTO_PACKAGE=true

# --- DRM (Widevine/FairPlay/PlayReady) integration point ---
# "none" disables DRM. Other values require a paid license server (ezDRM,
# Bitmovin, AWS MediaPackage, ...). Configure credentials below.
DRM_PROVIDER=none
DRM_LICENSE_URL=
DRM_API_KEY=

# --- Payme (Uzbekistan) payments ---
# Get these from your Payme merchant cabinet (https://merchant.paycom.uz/).
# Leave PAYME_MERCHANT_ID blank to disable payments — pay/* endpoints will
# return 502 payment_provider_unconfigured.
PAYME_MERCHANT_ID=
PAYME_KEY=
# When true, hits Payme's sandbox (test.paycom.uz). Set to false in prod.
PAYME_TEST_MODE=true
# Override only if Payme tells you to.
PAYME_API_URL=
PAYME_CHECKOUT_URL=