meta {
  name: Login (captures tokens)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{user_email}}",
    "password": "{{user_password}}"
  }
}

tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

script:post-response {
  const j = res.getBody();
  if (j.access_token) bru.setEnvVar('access_token', j.access_token);
  if (j.refresh_token) bru.setEnvVar('refresh_token', j.refresh_token);
}
