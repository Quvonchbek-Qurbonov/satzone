meta {
  name: Submit assessment (student)
  type: http
  seq: 18
}

post {
  url: {{base_url}}/assessments/{{assessment_id}}/submissions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "answers": [
      {"question_id": "{{question_id}}", "selected_option_ids": ["{{option_id}}"]}
    ]
  }
}
