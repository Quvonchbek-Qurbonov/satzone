meta {
  name: Update onboarding
  type: http
  seq: 2
}

put {
  url: {{base_url}}/onboarding
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "headline": "Aspiring backend engineer",
    "bio": "Learning Python and FastAPI.",
    "skill_level": "intermediate",
    "weekly_goal_minutes": 300,
    "learning_goal": "Ship a SaaS in 90 days",
    "locale": "en",
    "timezone": "UTC",
    "interest_category_ids": ["{{category_id}}"],
    "mark_completed": true
  }
}
