meta {
  name: Update my review
  type: http
  seq: 3
}

put {
  url: {{base_url}}/courses/{{course_slug}}/reviews/me
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "rating": 4,
    "comment": "Updated my take after finishing the course."
  }
}
