meta {
  name: Create review (must be enrolled)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/courses/{{course_slug}}/reviews
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "rating": 5,
    "comment": "Excellent — exactly what I needed."
  }
}
