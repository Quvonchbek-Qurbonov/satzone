meta {
  name: Reorder sections
  type: http
  seq: 17
}

post {
  url: {{base_url}}/instructor/courses/{{instructor_course_id}}/sections/reorder
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "items": [
      {"id": "{{section_id}}", "order": 0}
    ]
  }
}
