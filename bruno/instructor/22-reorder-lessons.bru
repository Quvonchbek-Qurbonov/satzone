meta {
  name: Reorder lessons
  type: http
  seq: 22
}

post {
  url: {{base_url}}/instructor/sections/{{section_id}}/lessons/reorder
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "items": [
      {"id": "{{instructor_lesson_id}}", "order": 0}
    ]
  }
}
