meta {
  name: Create section
  type: http
  seq: 16
}

post {
  url: {{base_url}}/instructor/courses/{{instructor_course_id}}/sections
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Intro"
  }
}

tests {
  test("201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

script:post-response {
  const j = res.getBody();
  if (j && j.id) bru.setEnvVar('section_id', j.id);
}
