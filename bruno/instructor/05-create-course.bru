meta {
  name: Create course
  type: http
  seq: 5
}

post {
  url: {{base_url}}/instructor/courses
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "title": "My New Course",
    "subtitle": "Short pitch",
    "description": "A reasonably long description suitable for publish.",
    "category_id": "{{category_id}}",
    "level": "beginner",
    "price_cents": 4999,
    "tags": ["api", "smoke"]
  }
}

tests {
  test("201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

script:post-response {
  const j = res.getBody();
  if (j && j.id) bru.setEnvVar('instructor_course_id', j.id);
  if (j && j.slug) bru.setEnvVar('course_slug', j.slug);
}
