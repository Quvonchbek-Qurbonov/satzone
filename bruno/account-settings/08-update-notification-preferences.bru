meta {
  name: Update notification preferences
  type: http
  seq: 8
}

patch {
  url: {{base_url}}/me/preferences/notifications
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "email_marketing": false,
    "email_announcements": true,
    "email_course_updates": true,
    "push_enabled": true
  }
}
