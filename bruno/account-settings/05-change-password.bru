meta {
  name: Change password
  type: http
  seq: 5
}

put {
  url: {{base_url}}/me/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "current_password": "{{user_password}}",
    "new_password": "BrandNewPass123!"
  }
}
