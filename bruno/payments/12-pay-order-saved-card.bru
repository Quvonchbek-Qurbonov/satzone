meta {
  name: Pay order (saved card)
  type: http
  seq: 12
}

post {
  url: {{base_url}}/orders/{{order_id}}/pay/card
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "payment_method_id": "{{payment_method_id}}"
  }
}
