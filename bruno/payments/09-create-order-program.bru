meta {
  name: Create order (program)
  type: http
  seq: 9
}

post {
  url: {{base_url}}/orders
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "item_kind": "program",
    "program_id": "{{program_id}}"
  }
}
