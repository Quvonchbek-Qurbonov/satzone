meta {
  name: Lookup user by phone
  type: http
  seq: 1
}

post {
  url: {{base_url}}/internal/users/lookup-by-phone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-API-Key: {{internal_api_key}}
}

body:json {
  {
    "phone_number": "{{user_phone}}"
  }
}

docs {
  Returns the user matching `phone_number` (E.164). 404 `user_not_found` if no match. 401 `invalid_api_key` if the header is wrong; 401 `internal_not_configured` if `INTERNAL_API_KEY` is unset on the server.
}
