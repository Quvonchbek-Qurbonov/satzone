meta {
  name: List lesson attachments
  type: http
  seq: 1
}

get {
  url: {{base_url}}/lessons/{{lesson_id}}/attachments
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  const j = res.getBody();
  if (Array.isArray(j) && j.length) bru.setEnvVar('attachment_id', j[0].id);
}
