meta {
  name: Users — patch (role / is_active / verify)
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/admin/users/{{user_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "role": "instructor",
    "is_active": true,
    "is_verified": true
  }
}
