meta {
  name: DRM license proxy (raw binary challenge)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/lessons/{{lesson_id}}/drm/license
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  <binary EME challenge bytes>
}
